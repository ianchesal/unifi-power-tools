# unifi-power-tools configuration. For local dev copy to server/.env; for
# docker compose copy to .env in the repo root.
#
# LAN tool: never expose this service to the internet.

# --- Required ---------------------------------------------------------------

# Bearer token clients must send as `Authorization: Bearer <MCP_SECRET>` to /mcp.
# Choose a strong random value.
MCP_SECRET=

# Password for the dashboard and REST API. Must differ from MCP_SECRET.
# Changing it signs everyone out.
DASHBOARD_PASSWORD=

# --- HTTP (dashboard, /api, /mcp, /health, /ready) ---------------------------

PORT=3002
LOG_LEVEL=info

# Bind address. Default 127.0.0.1 (localhost only); the Docker image sets
# 0.0.0.0 and you control exposure with how the port is published. Leave this
# commented out for Docker: an env file overrides the image. For local dev, set
# it to your LAN interface IP only if you deliberately want other devices in.
# HOST=127.0.0.1

# Only when a reverse proxy (e.g. Nginx Proxy Manager) sits in front: its
# address, subnet or hop count, passed to Express `trust proxy`. Lets the
# session cookie be marked Secure behind TLS and the login rate limit see real
# client IPs. Never `true` (rejected at startup).
# TRUST_PROXY=

# --- Syslog ingest -----------------------------------------------------------

SYSLOG_UDP_PORT=10514
SYSLOG_BIND_ADDRESS=0.0.0.0
# Oversized datagrams are dropped and counted in /health.
MAX_MESSAGE_BYTES=16384
RETENTION_DAYS=90

# --- Databases ---------------------------------------------------------------

# Defaults: ./data/events.db and ./data/lens.db; the Docker image sets
# /data/events.db and /data/lens.db (its volume). Leave these commented out for
# Docker, or the databases end up outside the volume.
# EVENTS_DB_PATH=./data/events.db
# LENS_DB_PATH=./data/lens.db

# --- UniFi Network API (optional: set both or neither) -----------------------

# Enables the UniFi MCP tools and client-name enrichment of analysis context.
# Gateway IP or hostname (a pasted https:// URL is accepted too).
# UNIFI_HOST=192.168.1.1
# UNIFI_API_KEY=
# UNIFI_SITE=default
# UNIFI_VERIFY_TLS=false
# UNIFI_REQUEST_TIMEOUT_MS=10000

# Off by default. Only the literal `true` registers the UniFi write tools
# (create_/update_/delete_/block_/unblock_/set_/remove_) on /mcp. Triage
# sessions read attacker-influenced event text; leave this off unless you
# deliberately want an MCP client able to change the network.
# UNIFI_ALLOW_WRITES=false

# --- Analysis ----------------------------------------------------------------

LAN_CIDRS=10.0.0.0/8,192.168.0.0/16,172.16.0.0/12

# Comma-separated admin display names (as they appear in UniFi's audit log)
# that auto-close console-login findings for those admins. Empty = rule never fires.
TRUSTED_ADMIN_NAMES=

# Comma-separated IDS/IPS signature-family prefixes that auto-close a finding
# when every backing event is a blocked hit from one of these families.
# Defaults to ET DROP,ET CINS,ET TOR,ET COMPROMISED,ET DSHIELD if unset.
# SAFE_SIGNATURE_PREFIXES=

# Path to a local, never-committed JSON file mapping LAN host IPs to the
# services running on them, so analysis context can label traffic to a host:port
# by service name. See homelab-services.example.json. Missing file = no-op.
# HOMELAB_SERVICES_PATH=./data/homelab-services.json
